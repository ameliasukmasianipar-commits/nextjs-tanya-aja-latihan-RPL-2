# Salin file ini menjadi .env.local lalu isi nilainya (Handbook Hari 04 Tahap 2).
# Tulis nilai tepat setelah tanda =, tanpa spasi dan tanpa tanda kutip.
# Jangan pernah memakai awalan NEXT_PUBLIC_ untuk variabel di bawah ini.

# ID aplikasi milikmu dari pemateri. Huruf kecil, angka, tanda hubung.
# Bentuknya seperti siswa-01. Setiap siswa memakai ID yang berbeda.
GROUP_ID=

# PIN pemilik: tepat 4 angka pilihanmu sendiri. Hindari 0000 dan 1234.
OWNER_PIN=

# Alamat project Supabase dari pemateri (https://....supabase.co)
SUPABASE_URL=

# Kunci rahasia Supabase dari pemateri (sb_secret_...).
# Hanya untuk server. Jangan dibagikan, difoto, atau di-commit.
SUPABASE_SECRET_KEY=
